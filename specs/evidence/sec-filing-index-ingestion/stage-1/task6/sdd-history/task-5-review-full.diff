+L214:         }
+L215:       },
+L216:       "resources": [
+L217:         {
+L218:           "type": "Microsoft.OperationalInsights/workspaces",
+L219:           "apiVersion": "<ApiVersion>",
+L220:           "name": "[parameters('workspaceName')]",
