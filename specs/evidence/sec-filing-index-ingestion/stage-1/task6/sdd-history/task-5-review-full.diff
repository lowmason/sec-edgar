+L402:       parent: logAnalyticsWorkspace
+L403:       name: tableName
+L404:       properties: {
+L405:         retentionInDays: retentionInDays
+L406:         totalRetentionInDays: totalRetentionInDays
+L407:       }
+L408:     }
+L409:     `
