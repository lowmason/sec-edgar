+def retain_coordination_trace(name, events):
+    import os
+    destination = os.environ.get("SEC_EDGAR_TASK4_TRACE_DIR")
+    if destination:
+        root = Path(destination)
+        root.mkdir(parents=True, exist_ok=True)
