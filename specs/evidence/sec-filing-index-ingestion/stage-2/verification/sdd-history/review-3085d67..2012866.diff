+
+    def test_reopening_lease_client_preserves_existing_sentinel_journal(self):
+        sentinel = self.root / "objects/locks/sec-owner-lowell-mason/sentinel.json"
+        journal = b'{"epoch":12,"not_before":"2026-10-06T00:00:30+00:00"}'
