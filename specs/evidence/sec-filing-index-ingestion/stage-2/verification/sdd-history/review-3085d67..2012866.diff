+        self.assertEqual(request.headers["x-ms-version"], "2026-04-06")
+        self.assertEqual(request.headers["If-None-Match"], "*")
+        self.assertNotIn("If-Match", request.headers)
+        self.assertEqual(request.body, b"manifest")
