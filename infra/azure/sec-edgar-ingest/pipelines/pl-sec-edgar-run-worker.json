                      "dependsOn": [
                        {
                          "activity": "Classify result",
                          "dependencyConditions": [
                            "Completed"
                          ]
                        }
                      ],
                      "typeProperties": {
                        "variableName": "outcome",
                        "value": {
                          "value": "@if(empty(variables('executionOutcome')), variables('resultOutcome'), variables('executionOutcome'))",
                          "type": "Expression"
                        }
                      }
                    },
                    {
                      "name": "Mark classified",
                      "type": "SetVariable",
                      "dependsOn": [
                        {
                          "activity": "Classify outcome",
                          "dependencyConditions": [
                            "Succeeded"
                          ]
                        }
                      ],
                      "typeProperties": {
                        "variableName": "classified",
                        "value": {
                          "value": "@variables('launch')",
                          "type": "Expression"
                        }
                      }
                    },
                    {
                      "name": "Classify next",
                      "type": "SetVariable",
                      "dependsOn": [
                        {
                          "activity": "Mark classified",
                          "dependencyConditions": [
                            "Succeeded"
                          ]
                        }
                      ],
                      "typeProperties": {
                        "variableName": "nextPhase",
                        "value": {
                          "value": "@if(and(equals(variables('outcome'), 'pending'), less(int(variables('launch')), pipeline().parameters.maxLaunches)), 'start', 'done')",
                          "type": "Expression"
                        }
                      }
                    }
                  ]
                }
              ],
              "defaultActivities": [
                {
                  "name": "Stop launches",
                  "type": "SetVariable",
                  "typeProperties": {
                    "variableName": "nextPhase",
                    "value": "done"
                  }
                }
              ]
            }
          },
          {
            "name": "Advance",
            "type": "SetVariable",
            "dependsOn": [
              {
                "activity": "Launch phase",
                "dependencyConditions": [
                  "Completed"
                ]
              }
            ],
            "typeProperties": {
              "variableName": "phase",
              "value": {
                "value": "@variables('nextPhase')",
                "type": "Expression"
              }
            }
          }
        ]
      }
    },
    {
      "name": "Check outcome",
      "type": "IfCondition",
      "dependsOn": [
        {
          "activity": "Run launches",
          "dependencyConditions": [
            "Completed"
          ]
        }
      ],
      "typeProperties": {
        "expression": {
          "value": "@equals(variables('outcome'), 'success')",
          "type": "Expression"
        },
        "ifTrueActivities": [],
        "ifFalseActivities": [
          {
            "name": "Fail run",
            "type": "Fail",
            "typeProperties": {
              "message": {
                "value": "@concat('pl-sec-edgar-run-worker ', pipeline().parameters.command, ' run ', pipeline().parameters.runId, ' launch-', variables('launch'), ' ended ', if(empty(variables('outcome')), 'execution_unknown', variables('outcome')))",
                "type": "Expression"
              },
              "errorCode": {
                "value": "@if(empty(variables('outcome')), 'execution_unknown', variables('outcome'))",
                "type": "Expression"
              }
            }
          }
        ]
      }
    }
  ],
  "variables": {
    "phase": {
      "type": "String",
      "defaultValue": "start"
    },
    "nextPhase": {
      "type": "String",
      "defaultValue": ""
    },
    "launch": {
      "type": "String",
      "defaultValue": "0"
    },
    "nextLaunch": {
      "type": "String",
      "defaultValue": "0"
    },
    "classified": {
      "type": "String",
      "defaultValue": "0"
    },
    "launchedAt": {
      "type": "String",
      "defaultValue": ""
    },
    "executionName": {
      "type": "String",
      "defaultValue": ""
    },
    "location": {
      "type": "String",
      "defaultValue": ""
    },
    "state": {
      "type": "String",
      "defaultValue": ""
    },
    "image": {
      "type": "String",
      "defaultValue": ""
    },
    "waitSeconds": {
      "type": "String",
      "defaultValue": ""
    },
    "result": {
      "type": "String",
      "defaultValue": ""
    },
    "executionOutcome": {
      "type": "String",
      "defaultValue": ""
    },
    "resultOutcome": {
      "type": "String",
      "defaultValue": ""
    },
    "outcome": {
      "type": "String",
      "defaultValue": ""
    },
    "knownOutcomes": {
      "type": "Array",
      "defaultValue": [
        "success",
        "no_new_sources",
        "unchanged",
        "configuration",
        "approval_refused",
        "rollback_refused",
        "discovery_failed",
        "incomplete",
        "pending",
        "retry_exhausted",
        "deferred",
        "throttled",
        "access_blocked",
        "quarantined",
        "invalid_source",
        "ownership_lost",
        "state_conflict",
        "internal_error",
        "publication_conflict",
        "awaiting_approval",
        "approval_stale",
        "rollback_stale"
      ]
    },
    "exitZeroOutcomes": {
      "type": "Array",
      "defaultValue": [
        "success",
        "no_new_sources",
        "unchanged"
      ]
    },
    "staleOutcomes": {
      "type": "Array",
      "defaultValue": [
        "approval_stale",
        "rollback_stale"
      ]
    }
  }
}
